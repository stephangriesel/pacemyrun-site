---
import Layout from '../layouts/Layout.astro';
import RadioGroup from '../components/RadioGroup.astro';
import {
  conditionOptions, walkOptions, experienceOptions, goalOptions, exerciseOptions, sleepOptions,
} from '../lib/questionnaire';
---
<Layout title="Training advice">
  <div id="form-view">
    <h1>Running questionnaire</h1>
    <p>Answer a few questions and get a personalised training report. Everything happens in your browser; nothing is sent anywhere.</p>
    <form id="q-form">
      <div class="field"><label for="height">Height (cm)</label><input type="number" id="height" name="height" min="100" max="250" required /></div>
      <div class="field"><label for="weight">Weight (kg)</label><input type="number" id="weight" name="weight" min="25" max="300" step="any" required /></div>
      <div class="field"><label for="age">Age</label><input type="number" id="age" name="age" min="10" max="100" required /></div>

      <RadioGroup name="walk" legend="How much do you walk every day?" options={walkOptions} />
      <RadioGroup name="experience" legend="What kind of runner are you?" options={experienceOptions} />
      <RadioGroup name="goal" legend="My goal is to run…" options={goalOptions} />
      <RadioGroup name="exercise" legend="In a week, how many days do you exercise for more than 30 minutes?" options={exerciseOptions} />
      <RadioGroup name="sleep" legend="How much do you usually sleep per night?" options={sleepOptions} />

      <fieldset>
        <legend>Have you been diagnosed with any of the following? (select all that apply)</legend>
        {conditionOptions.map((c) => (
          <label class="opt"><input type="checkbox" name="conditions" value={c.value} /> {c.label}</label>
        ))}
        <label class="opt"><input type="checkbox" id="none" /> None of the above</label>
      </fieldset>

      <button type="submit">Get my report</button>
    </form>
  </div>

  <div id="report-view" hidden>
    <h1>Your PaceMyRun report</h1>
    <article class="advice" id="report"></article>
    <button type="button" id="back">Back to questionnaire</button>
  </div>
</Layout>

<script>
  import { buildReport } from '../lib/advice';
  import type { Answers } from '../lib/questionnaire';

  const form = document.querySelector<HTMLFormElement>('#q-form')!;
  const formView = document.querySelector<HTMLElement>('#form-view')!;
  const reportView = document.querySelector<HTMLElement>('#report-view')!;
  const report = document.querySelector<HTMLElement>('#report')!;
  const none = form.querySelector<HTMLInputElement>('#none')!;
  const others = [...form.querySelectorAll<HTMLInputElement>('input[name="conditions"]')];

  // "None" is exclusive with the specific conditions; it is not part of the data.
  none.addEventListener('change', () => { if (none.checked) others.forEach((o) => (o.checked = false)); });
  others.forEach((o) => o.addEventListener('change', () => { if (o.checked) none.checked = false; }));

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string) =>
    Object.assign(document.createElement(tag), text ? { textContent: text } : {});

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const answers = {
      height: Number(d.get('height')),
      weight: Number(d.get('weight')),
      age: Number(d.get('age')),
      walk: d.get('walk'),
      experience: d.get('experience'),
      goal: d.get('goal'),
      exercise: d.get('exercise'),
      sleep: d.get('sleep'),
      conditions: d.getAll('conditions'),
    } as Answers;

    // textContent only: no HTML is ever built from strings.
    report.replaceChildren(
      ...buildReport(answers).flatMap((s) => {
        const nodes: HTMLElement[] = [el('h2', s.title), ...s.paragraphs.map((p) => el('p', p))];
        if (s.bullets?.length) {
          const ul = el('ul');
          ul.append(...s.bullets.map((b) => el('li', b)));
          nodes.push(ul);
        }
        if (s.links?.length) {
          const ul = el('ul');
          ul.append(...s.links.map((l) => {
            const li = el('li');
            const a = Object.assign(el('a', l.label), { href: l.href, target: '_blank', rel: 'noopener noreferrer' });
            li.append(a);
            return li;
          }));
          nodes.push(ul);
        }
        return nodes;
      }),
    );
    formView.hidden = true;
    reportView.hidden = false;
    window.scrollTo(0, 0);
  });

  document.querySelector('#back')!.addEventListener('click', () => {
    reportView.hidden = true;
    formView.hidden = false;
  });
</script>
